<ResultLabel>:
    adaptive_height: True
    halign: "center"
    text_size: None, None

    canvas.before:
        Color:
            rgba: self.theme_cls.surfaceContainerLowColor

        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8]


<ResultBox>:
    orientation: "vertical"
    adaptive_height: True
    spacing: "4dp"


<CalculateBox>:
    id: root_box
    orientation: "vertical"
    size_hint: 1, 1
    padding: [30, 10, 30, 0]

    MDBoxLayout:
        size_hint_y: None
        height: "50dp"
        SizableFabBtn:
            icon: "calculator"

            theme_shadow_color: "Custom"
            shadow_color: 0, 0, 0, 0
            theme_bg_color: "Custom"
            theme_icon_color: "Custom"
            md_bg_color: self.theme_cls.primaryColor
            icon_color: self.theme_cls.surfaceColor

            on_release: root_box.on_button_press()

    RestrictedScrollView:
        clip_behavior: "clip_children"
        do_scroll_x: False
        do_scroll_y: True

        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: max(self.minimum_height, self.parent.height)
            spacing: "10dp"

            Widget:
                size_hint_y: 1

            ResultBox:
                id: result_box
                size_hint_y: None
                height: self.minimum_height

            Widget:
                size_hint_y: 1
