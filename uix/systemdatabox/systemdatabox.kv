<SystemDataBox>:
    orientation: "vertical"
    adaptive_height: True
    spacing: "5sp"

    ParameterBox:
        id: size_param_box
        SizeParam:
            id: size_param
            min_value: root.min_size
            max_value: root.max_size

		ParameterBox:
			id: extra_params_box

		ParameterBox:
			id: system_input_box
